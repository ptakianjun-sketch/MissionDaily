
#include <iostream>
#include <vector>
#include <string>
#include <limits>
using namespace std;

struct Mission {
    string name;
    bool completed;
};

vector<Mission> missions;

// รับตัวเลขจากแป้นพิมพ์
int getNumber(string message) {
    int number;

    while (true) {
        cout << message;

        if (cin >> number) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return number;
        }

        cout << "กรุณากรอกเป็นตัวเลขเท่านั้น!\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

// เพิ่มภารกิจ
void addMission() {
    Mission m;

    cout << "\n=== ADD MISSION ===\n";
    cout << "ชื่อภารกิจ: ";
    getline(cin, m.name);

    if (m.name.empty()) {
        cout << "ไม่สามารถเพิ่มภารกิจว่างได้!\n";
        return;
    }

    m.completed = false;
    missions.push_back(m);

    cout << "เพิ่มภารกิจสำเร็จ!\n";
}

// แสดงรายการภารกิจ
void showMission() {
    cout << "\n=== MY MISSIONS ===\n";

    if (missions.empty()) {
        cout << "ยังไม่มีภารกิจ\n";
        return;
    }

    for (int i = 0; i < missions.size(); i++) {
        cout << i + 1 << ". "
             << missions[i].name;

        if (missions[i].completed) {
            cout << " [สำเร็จแล้ว]";
        } else {
            cout << " [ยังไม่สำเร็จ]";
        }

        cout << endl;
    }
}

// ทำเครื่องหมายภารกิจสำเร็จ
void completeMission() {
    showMission();

    if (missions.empty()) return;

    int choice = getNumber("\nเลือกภารกิจที่ทำสำเร็จ: ");

    if (choice >= 1 && choice <= missions.size()) {
        missions[choice - 1].completed = true;
        cout << "ภารกิจสำเร็จแล้ว! ยินดีด้วย!\n";
    } else {
        cout << "ไม่พบหมายเลขภารกิจ!\n";
    }
}

// ลบภารกิจ
void deleteMission() {
    showMission();

    if (missions.empty()) return;

    int choice = getNumber("\nเลือกภารกิจที่ต้องการลบ: ");

    if (choice >= 1 && choice <= missions.size()) {
        missions.erase(missions.begin() + choice - 1);
        cout << "ลบภารกิจเรียบร้อย!\n";
    } else {
        cout << "ไม่พบหมายเลขภารกิจ!\n";
    }
}

// สรุปความคืบหน้า
void summary() {
    int completed = 0;

    for (int i = 0; i < missions.size(); i++) {
        if (missions[i].completed) {
            completed++;
        }
    }

    cout << "\n=== DAILY SUMMARY ===\n";
    cout << "ภารกิจทั้งหมด: " << missions.size() << endl;
    cout << "สำเร็จแล้ว: " << completed << endl;
    cout << "คงเหลือ: " << missions.size() - completed << endl;

    if (!missions.empty()) {
        double percent =
            (double)completed / missions.size() * 100;

        cout << "ความสำเร็จ: " << percent << "%\n";
    }
}

// โปรแกรมหลัก
int main() {
    int menu;

    do {
        cout << "\n";
        cout << "================================\n";
        cout << "       MISSION DAILY APP\n";
        cout << "================================\n";
        cout << " 1. เพิ่มภารกิจ\n";
        cout << " 2. ดูรายการภารกิจ\n";
        cout << " 3. ทำภารกิจสำเร็จ\n";
        cout << " 4. ลบภารกิจ\n";
        cout << " 5. สรุปผลประจำวัน\n";
        cout << " 0. ออกจากโปรแกรม\n";
        cout << "================================\n";

        menu = getNumber("เลือกเมนู: ");

        switch (menu) {
            case 1:
                addMission();
                break;

            case 2:
                showMission();
                break;

            case 3:
                completeMission();
                break;

            case 4:
                deleteMission();
                break;

            case 5:
                summary();
                break;

            case 0:
                cout << "\nขอบคุณที่ใช้ MISSION DAILY!\n";
                break;

            default:
                cout << "กรุณาเลือกเมนู 0-5 เท่านั้น!\n";
        }

    } while (menu != 0);

    return 0;
}
